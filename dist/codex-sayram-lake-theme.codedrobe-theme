      "css": "/*\n * 赛里木湖 · 天山清晨 · Static edition\n *\n * Renderer-only visual layer.  The photograph is a single fixed background;\n * readable UI surfaces are intentionally opaque or nearly opaque.  There is\n * no backdrop-filter, CSS filter, animation, universal descendant styling, or\n * broad transparent overlay in this edition.\n */\n\n:root.codedrobe-codex-skin {\n  color-scheme: light;\n\n  --xinjiang-ink: #163b4b;\n  --xinjiang-deep: #0c3040;\n  --xinjiang-muted: #426477;\n  --xinjiang-faint: #5c7785;\n  --xinjiang-lake: #2c7892;\n  --xinjiang-teal: #174e61;\n  --xinjiang-teal-soft: rgba(21, 77, 95, 0.68);\n  --xinjiang-gold: #bd8140;\n  --xinjiang-gold-light: #e0ad64;\n  --xinjiang-green: #198653;\n  --xinjiang-red: #bd4d49;\n  --xinjiang-line: rgba(21, 75, 89, 0.22);\n  --xinjiang-line-soft: rgba(21, 75, 89, 0.14);\n  --xinjiang-surface: rgba(237, 247, 246, 0.92);\n  --xinjiang-surface-strong: rgba(246, 251, 250, 0.97);\n  --xinjiang-surface-soft: rgba(225, 241, 240, 0.84);\n  --xinjiang-surface-dark: rgba(18, 63, 77, 0.86);\n  --xinjiang-shadow: 0 8px 22px rgba(13, 55, 70, 0.14);\n\n  /* Native token families.  These are deliberately high-contrast values. */\n  --color-token-text-primary: var(--xinjiang-ink);\n  --color-token-text-secondary: var(--xinjiang-muted);\n  --color-token-text-tertiary: var(--xinjiang-faint);\n  --color-token-main-surface-primary: var(--xinjiang-surface);\n  --color-token-main-surface-secondary: var(--xinjiang-surface-soft);\n  --color-token-sidebar-surface-primary: var(--xinjiang-teal);\n  --color-token-sidebar-surface-secondary: var(--xinjiang-teal-soft);\n  --color-token-border-medium: var(--xinjiang-line);\n  --color-token-border-light: var(--xinjiang-line-soft);\n  --color-token-accent: var(--xinjiang-gold);\n  --theme-surface: var(--xinjiang-surface);\n  --theme-surface-secondary: var(--xinjiang-surface-soft);\n  --theme-text: var(--xinjiang-ink);\n  --theme-text-secondary: var(--xinjiang-muted);\n  --theme-border: var(--xinjiang-line);\n  --theme-accent: var(--xinjiang-gold);\n}\n\n/* ---------- One clear landscape layer ---------- */\n\nhtml.codedrobe-codex-skin,\nhtml.codedrobe-codex-skin body {\n  min-height: 100%;\n  background: #a9cdd8 !important;\n  color: var(--xinjiang-ink) !important;\n}\n\nhtml.codedrobe-codex-skin body {\n  position: relative;\n  font-family: ui-sans-serif, system-ui, -apple-system, \"Segoe UI\",\n    \"Microsoft YaHei UI\", sans-serif !important;\n}\n\nhtml.codedrobe-codex-skin body::before {\n  content: \"\";\n  position: fixed;\n  z-index: 0;\n  inset: 0;\n  pointer-events: none;\n  background-image: var(--dream-art);\n  background-position: center center;\n  background-repeat: no-repeat;\n  background-size: cover;\n}\n\nhtml.codedrobe-codex-skin body::after {\n  content: none;\n}\n\nhtml.codedrobe-codex-skin #root {\n  position: relative;\n  z-index: 1;\n  min-height: 100vh;\n  background: transparent !important;\n  color: var(--xinjiang-ink) !important;\n}\n\nhtml.codedrobe-codex-skin #root > div {\n  background: transparent !important;\n}\n\n/* CodeDrobe's verification node is not part of the native UI. */\nhtml.codedrobe-codex-skin #codedrobe-codex-skin-chrome {\n  display: none !important;\n  opacity: 0 !important;\n  pointer-events: none !important;\n  background: transparent !important;\n  border: 0 !important;\n  box-shadow: none !important;\n}\n\n/* ---------- Stable app surfaces ---------- */\n\nhtml.codedrobe-codex-skin [class*=\"_ApplicationMenuTopBar_\"] {\n  position: relative;\n  z-index: 4;\n  background: rgba(229, 243, 244, 0.95) !important;\n  border-bottom: 1px solid var(--xinjiang-line) !important;\n  box-shadow: 0 2px 8px rgba(13, 55, 70, 0.10) !important;\n  color: var(--xinjiang-deep) !important;\n}\n\nhtml.codedrobe-codex-skin [class*=\"_ApplicationMenuTopBar_\"]\n  :where(button, a, span) {\n  color: var(--xinjiang-deep) !important;\n  -webkit-text-fill-color: currentColor !important;\n}\n\nhtml.codedrobe-codex-skin [class*=\"_ApplicationMenuTopBar_\"]\n  :where(button, a):hover {\n  background: rgba(255, 255, 255, 0.58) !important;\n  color: var(--xinjiang-lake) !important;\n}\n\nhtml.codedrobe-codex-skin aside.app-shell-left-panel {\n  position: relative;\n  z-index: 3;\n  color: #f4fbf9 !important;\n  background:\n    linear-gradient(rgba(17, 72, 87, 0.72), rgba(17, 72, 87, 0.72)),\n    var(--dream-art) center / cover no-repeat !important;\n  border-right: 1px solid rgba(229, 247, 243, 0.35) !important;\n  box-shadow: 4px 0 14px rgba(8, 42, 54, 0.13) !important;\n}\n\nhtml.codedrobe-codex-skin aside.app-shell-left-panel\n  :where(a, button, [role=\"button\"], h1, h2, h3, h4, h5, h6, p, span, label) {\n  color: #f4fbf9 !important;\n  -webkit-text-fill-color: currentColor !important;\n}\n\nhtml.codedrobe-codex-skin aside.app-shell-left-panel\n  :where(a, button, [role=\"button\"]) {\n  background: transparent !important;\n  border-color: transparent !important;\n  border-radius: 10px !important;\n  box-shadow: none !important;\n  text-shadow: 0 1px 2px rgba(6, 35, 47, 0.58) !important;\n}\n\nhtml.codedrobe-codex-skin aside.app-shell-left-panel\n  :where(a, button, [role=\"button\"]):hover {\n  background: rgba(234, 248, 244, 0.17) !important;\n  color: #ffffff !important;\n}\n\nhtml.codedrobe-codex-skin aside.app-shell-left-panel\n  :where([aria-current=\"page\"], [data-state=\"active\"], [aria-selected=\"true\"]) {\n  background: rgba(221, 174, 100, 0.36) !important;\n  box-shadow: inset 3px 0 0 var(--xinjiang-gold-light) !important;\n  color: #ffffff !important;\n}\n\nhtml.codedrobe-codex-skin aside.app-shell-left-panel :where(svg, path) {\n  color: currentColor !important;\n  stroke: currentColor !important;\n}\n\n/* The right project/source panel gets one readable light surface. */\nhtml.codedrobe-codex-skin aside:not(.app-shell-left-panel) {\n  position: relative;\n  z-index: 3;\n  background: var(--xinjiang-surface-strong) !important;\n  border-left: 1px solid var(--xinjiang-line) !important;\n  color: var(--xinjiang-ink) !important;\n}\n\nhtml.codedrobe-codex-skin aside:not(.app-shell-left-panel)\n  :where(h1, h2, h3, h4, h5, h6, p, span, label, a, button, [role=\"button\"]) {\n  color: var(--xinjiang-ink) !important;\n  -webkit-text-fill-color: currentColor !important;\n}\n\nhtml.codedrobe-codex-skin aside:not(.app-shell-left-panel)\n  :where(a, button, [role=\"button\"]):hover {\n  background: rgba(189, 129, 64, 0.12) !important;\n  color: var(--xinjiang-deep) !important;\n}\n\nhtml.codedrobe-codex-skin main[class*=\"_MainContentSurface_\"] {\n  position: relative;\n  z-index: 1;\n  min-width: 0;\n  color: var(--xinjiang-ink) !important;\n  /* Keep the Sayram Lake artwork as the actual work-area background.\n     Readability is handled by local transcript/composer surfaces below. */\n  background: transparent !important;\n  background-image: none !important;\n  border-left: 1px solid rgba(255, 255, 255, 0.50) !important;\n  box-shadow: none !important;\n}\n\nhtml.codedrobe-codex-skin main[class*=\"_MainContentSurface_\"]\n  :where([class*=\"_MainContentViewport_\"], [class*=\"_MainContentFrame_\"]) {\n  background: transparent !important;\n}\n\n/* Keep normal main text dark even when native light/dark utility tokens vary. */\nhtml.codedrobe-codex-skin main[class*=\"_MainContentSurface_\"]\n  :where(h1, h2, h3, h4, h5, h6, p, label, li, button, [role=\"button\"]) {\n  color: var(--xinjiang-ink) !important;\n  -webkit-text-fill-color: currentColor !important;\n}\n\nhtml.codedrobe-codex-skin main[class*=\"_MainContentSurface_\"]\n  :where([class*=\"text-secondary\"], [class*=\"text-tertiary\"],\n    [class*=\"text-muted\"], [class*=\"text-subtle\"]) {\n  color: var(--xinjiang-muted) !important;\n  -webkit-text-fill-color: currentColor !important;\n}\n\nhtml.codedrobe-codex-skin main[class*=\"_MainContentSurface_\"]\n  :where([class*=\"text-white\"], [class*=\"text-inverse\"],\n    [class*=\"text-on-\"], [class*=\"text-primary-inverse\"]) {\n  color: var(--xinjiang-ink) !important;\n  -webkit-text-fill-color: currentColor !important;\n  opacity: 1 !important;\n}\n\nhtml.codedrobe-codex-skin main[class*=\"_MainContentSurface_\"]\n  :where(a, a:visited) {\n  color: #1d6680 !important;\n  text-decoration-color: rgba(29, 102, 128, 0.44) !important;\n}\n\nhtml.codedrobe-codex-skin main[class*=\"_MainContentSurface_\"]\n  :where(a:hover) {\n  color: #8b5726 !important;\n  text-decoration-color: rgba(139, 87, 38, 0.60) !important;\n}\n\n/* Links and generated-file targets need a visual role of their own.  Keep\n   this rule narrow so ordinary text retains the ink color, while anchors,\n   explicit link roles, and Codex activity file targets remain findable in\n   screenshots and long-running transcripts. */\nhtml.codedrobe-codex-skin #root main[class*=\"_MainContentSurface_\"]\n  a,\nhtml.codedrobe-codex-skin #root main[class*=\"_MainContentSurface_\"]\n  [role=\"link\"],\nhtml.codedrobe-codex-skin #root main[class*=\"_MainContentSurface_\"]\n  [data-agent-activity-file-link] {\n  color: #0066cc !important;\n  -webkit-text-fill-color: #0066cc !important;\n  text-decoration-line: underline !important;\n  text-decoration-color: rgba(0, 102, 204, 0.74) !important;\n  text-decoration-thickness: 2px !important;\n  text-underline-offset: 2px !important;\n  font-weight: 600 !important;\n}\n\nhtml.codedrobe-codex-skin #root main[class*=\"_MainContentSurface_\"]\n  a:hover,\nhtml.codedrobe-codex-skin #root main[class*=\"_MainContentSurface_\"]\n  [role=\"link\"]:hover,\nhtml.codedrobe-codex-skin #root main[class*=\"_MainContentSurface_\"]\n  [data-agent-activity-file-link]:hover {\n  color: #004a82 !important;\n  -webkit-text-fill-color: #004a82 !important;\n  text-decoration-color: rgba(0, 74, 130, 0.86) !important;\n}\n\n/* Codex renders generated files and table mentions as role=button spans,\n   not anchors.  Color the text itself; the surrounding focus-ring wrapper\n   can stretch to a full table cell, so a background/border on that wrapper\n   creates a large empty box around a short filename. */\nhtml.codedrobe-codex-skin #root main[class*=\"_MainContentSurface_\"]\n  [class*=\"_TableCellFileLink_\"] {\n  color: #005fa8 !important;\n  -webkit-text-fill-color: #005fa8 !important;\n  font-weight: 600 !important;\n  text-decoration-line: underline !important;\n  text-decoration-color: rgba(0, 95, 168, 0.68) !important;\n  text-decoration-thickness: 1.5px !important;\n  text-underline-offset: 2px !important;\n}\n\nhtml.codedrobe-codex-skin #root main[class*=\"_MainContentSurface_\"]\n  [class*=\"_InlineMentionFocusRing_\"][role=\"button\"] {\n  color: #005fa8 !important;\n  -webkit-text-fill-color: #005fa8 !important;\n  font-weight: 600 !important;\n  text-decoration: none !important;\n}\n\nhtml.codedrobe-codex-skin #root main[class*=\"_MainContentSurface_\"]\n  [class*=\"_TableCellFileLink_\"]:hover {\n  color: #004a82 !important;\n  -webkit-text-fill-color: #004a82 !important;\n  text-decoration-color: rgba(0, 74, 130, 0.86) !important;\n}\n\nhtml.codedrobe-codex-skin #root main[class*=\"_MainContentSurface_\"]\n  [class*=\"_InlineMentionFocusRing_\"][role=\"button\"]:hover {\n  color: #004a82 !important;\n  -webkit-text-fill-color: #004a82 !important;\n}\n\n/* Inline commit hashes and file-name code mentions use a neutral pill in\n   the native renderer; keep the same high-visibility blue family. */\nhtml.codedrobe-codex-skin #root main[class*=\"_MainContentSurface_\"]\n  .inline-markdown[class*=\"_InlineMarkdown_\"] {\n  color: #005fa8 !important;\n  -webkit-text-fill-color: #005fa8 !important;\n  background: rgba(0, 102, 204, 0.14) !important;\n  border: 1px solid rgba(0, 102, 204, 0.30) !important;\n  border-radius: 5px !important;\n  font-weight: 600 !important;\n  padding: 0.12em 0.34em !important;\n}\n\n/* ---------- Transcript: solid enough for every old and new turn ---------- */\n\nhtml.codedrobe-codex-skin main[class*=\"_MainContentSurface_\"] [data-turn-key] {\n  background: var(--xinjiang-surface) !important;\n  border: 1px solid var(--xinjiang-line-soft) !important;\n  border-radius: 12px !important;\n  box-shadow: 0 2px 8px rgba(13, 55, 70, 0.06) !important;\n  box-sizing: border-box !important;\n  padding: 22px !important;\n  color: var(--xinjiang-ink) !important;\n}\n\nhtml.codedrobe-codex-skin main[class*=\"_MainContentSurface_\"]\n  [data-turn-key] :where(p, li, h1, h2, h3, h4, h5, h6, span, strong, em, blockquote) {\n  color: var(--xinjiang-ink) !important;\n  -webkit-text-fill-color: currentColor !important;\n}\n\nhtml.codedrobe-codex-skin main[class*=\"_MainContentSurface_\"]\n  [data-message-author-role=\"user\"] {\n  background: rgba(211, 235, 233, 0.95) !important;\n}\n\nhtml.codedrobe-codex-skin main[class*=\"_MainContentSurface_\"]\n  [data-message-author-role=\"assistant\"] {\n  background: rgba(241, 249, 248, 0.94) !important;\n}\n\n/* Remove the native full-width fade that produced detached white bars. */\nhtml.codedrobe-codex-skin main[class*=\"_MainContentSurface_\"]\n  :where([class*=\"bg-gradient-to-t\"]) {\n  background: transparent !important;\n  background-image: none !important;\n  box-shadow: none !important;\n}\n\n/* Native Codex can add these utilities after the theme is installed.  Keep\n   their surfaces raster-only so a streamed Goal cannot reintroduce a large\n   blur repaint through a late-mounted composer or status chip. */\nhtml.codedrobe-codex-skin main[class*=\"_MainContentSurface_\"]\n  :where([class*=\"_ComposerLayoutRoot_\"], [class*=\"backdrop-blur\"]) {\n  backdrop-filter: none !important;\n  -webkit-backdrop-filter: none !important;\n  filter: none !important;\n}\n\n/* Semantic separators remain one quiet teal pixel; decorative bars do not. */\nhtml.codedrobe-codex-skin main[class*=\"_MainContentSurface_\"]\n  :where(hr, [role=\"separator\"][aria-orientation=\"horizontal\"]) {\n  height: 1px !important;\n  min-height: 1px !important;\n  border: 0 !important;\n  background: var(--xinjiang-line-soft) !important;\n  box-shadow: none !important;\n}\n\n/* ---------- Composer ---------- */\n\nhtml.codedrobe-codex-skin main[class*=\"_MainContentSurface_\"]\n  [class*=\"_ComposerLayoutRoot_\"] {\n  position: relative;\n  z-index: 5;\n}\n\nhtml.codedrobe-codex-skin main[class*=\"_MainContentSurface_\"]\n  :where([class*=\"_ComposerLayoutBody_\"], [class*=\"_ComposerLayoutFooter_\"]) {\n  background: transparent !important;\n  background-image: none !important;\n  border: 0 !important;\n  box-shadow: none !important;\n}\n\n/* Keep the native typing surface.  The only intentional change here is\n   extra breathing room around the editable text. */\nhtml.codedrobe-codex-skin main[class*=\"_MainContentSurface_\"]\n  [class*=\"_RichTextInput_\"] {\n  padding: 9px 14px !important;\n}\n\n/* The global accessible focus treatment is useful for buttons, but the\n   native editor already owns its caret state.  Do not draw the gold focus\n   rectangle around the typing surface. */\nhtml.codedrobe-codex-skin main[class*=\"_MainContentSurface_\"]\n  [class*=\"_RichTextInput_\"]\n  :where(.ProseMirror.ProseMirror-focused,\n    .ProseMirror:focus,\n    .ProseMirror:focus-visible,\n    [contenteditable=\"true\"]:focus,\n    [contenteditable=\"true\"]:focus-visible) {\n  outline: none !important;\n  outline-offset: 0 !important;\n  box-shadow: none !important;\n}\n\nhtml.codedrobe-codex-skin main[class*=\"_MainContentSurface_\"]\n  [class*=\"_ComposerLayoutRoot_\"] :where(button, [role=\"button\"]) {\n  color: var(--xinjiang-ink) !important;\n  background: transparent !important;\n  border-color: transparent !important;\n  border-radius: 999px !important;\n  box-shadow: none !important;\n  -webkit-text-fill-color: currentColor !important;\n}\n\nhtml.codedrobe-codex-skin main[class*=\"_MainContentSurface_\"]\n  [class*=\"_ComposerLayoutRoot_\"] :where(button, [role=\"button\"]):hover {\n  color: #7b4c22 !important;\n  background: rgba(189, 129, 64, 0.16) !important;\n  border-color: rgba(189, 129, 64, 0.26) !important;\n}\n\nhtml.codedrobe-codex-skin main[class*=\"_MainContentSurface_\"]\n  [class*=\"_ComposerLayoutRoot_\"]\n  :where(button[type=\"submit\"], [data-testid*=\"send\"], [aria-label*=\"send\" i]) {\n  color: #fffaf0 !important;\n  background: var(--xinjiang-gold) !important;\n  border: 1px solid rgba(117, 71, 30, 0.30) !important;\n  box-shadow: 0 4px 10px rgba(129, 78, 29, 0.20) !important;\n  -webkit-text-fill-color: currentColor !important;\n}\n\n/* ---------- Menus, dialogs, pickers, project panels ---------- */\n\nhtml.codedrobe-codex-skin\n  :where([role=\"dialog\"], [role=\"menu\"], [role=\"listbox\"]) {\n  background: var(--xinjiang-surface-strong) !important;\n  background-image: none !important;\n  border: 1px solid var(--xinjiang-line) !important;\n  border-radius: 14px !important;\n  box-shadow: var(--xinjiang-shadow) !important;\n  color: var(--xinjiang-ink) !important;\n  opacity: 1 !important;\n}\n\nhtml.codedrobe-codex-skin\n  :where([class*=\"PopoverContent\"], [class*=\"popover-content\"]) {\n  background: var(--xinjiang-surface-strong) !important;\n  background-image: none !important;\n  border: 1px solid var(--xinjiang-line) !important;\n  border-radius: 14px !important;\n  box-shadow: var(--xinjiang-shadow) !important;\n  color: var(--xinjiang-ink) !important;\n  opacity: 1 !important;\n}\n\nhtml.codedrobe-codex-skin\n  :where([role=\"dialog\"], [role=\"menu\"], [role=\"listbox\"])\n  :where(button, [role=\"menuitem\"], [role=\"option\"], label, span, p) {\n  color: var(--xinjiang-ink) !important;\n  -webkit-text-fill-color: currentColor !important;\n  opacity: 1 !important;\n}\n\nhtml.codedrobe-codex-skin\n  :where([class*=\"PopoverContent\"], [class*=\"popover-content\"])\n  :where(button, [role=\"menuitem\"], [role=\"option\"], label, span, p) {\n  color: var(--xinjiang-ink) !important;\n  -webkit-text-fill-color: currentColor !important;\n  opacity: 1 !important;\n}\n\nhtml.codedrobe-codex-sk